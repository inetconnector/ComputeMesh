{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schemas/skill-manifest-1.0.json",
  "title": "ComputeMesh Skill Manifest",
  "type": "object",
  "required": ["skill_id", "name", "version", "description", "status"],
  "properties": {
    "schema_version": {"type": "string", "default": "1.0"},
    "skill_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["ACTIVE", "EXPERIMENTAL", "DEPRECATED", "DISABLED", "BROKEN"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "domains": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "intents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "negative_triggers": {"type": "array", "items": {"type": "string"}},
    "required_inputs": {"type": "array", "items": {"type": "string"}},
    "optional_inputs": {"type": "array", "items": {"type": "string"}},
    "required_tools": {"type": "array", "items": {"type": "string"}},
    "optional_tools": {"type": "array", "items": {"type": "string"}},
    "forbidden_tools": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "conflicts_with": {"type": "array", "items": {"type": "string"}},
    "fallback_skills": {"type": "array", "items": {"type": "string"}},
    "side_effect_level": {"enum": ["NONE", "READ", "WRITE_REVERSIBLE", "WRITE_IRREVERSIBLE", "EXECUTE"]},
    "risk_level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "estimated_context_tokens": {"type": "integer", "minimum": 0},
    "validation_rules": {"type": "array", "items": {"type": "string"}},
    "checksum": {"type": "string"},
    "signature": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/inference_response_payload.schema.json",
  "title": "Authenticated ComputeMesh inference response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "turn_id", "lease_id", "node_id", "model_id", "output"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "turn_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "lease_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "node_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "output": {"type": "string", "maxLength": 4194304},
    "tool_calls": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "function"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "type": {"const": "function"},
          "function": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "arguments"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 256},
              "arguments": {"type": "string", "maxLength": 131072}
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cpu_milliseconds": {"type": "integer", "minimum": 0},
        "gpu_milliseconds": {"type": "integer", "minimum": 0},
        "vram_byte_seconds": {"type": "integer", "minimum": 0},
        "network_bytes": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0},
        "external_cost_micros": {"type": "integer", "minimum": 0}
      }
    }
  }
}

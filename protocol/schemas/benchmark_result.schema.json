{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/benchmark_result.schema.json",
  "title": "ComputeMesh Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "benchmark_name", "captured_at", "profile_revision", "conditions", "metrics", "raw_samples"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "benchmark_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "captured_at": {"type": "string", "format": "date-time"},
    "profile_revision": {"type": "integer", "minimum": 0},
    "conditions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["warm_state"],
      "dependentRequired": {
        "peer_node_id": ["peer_identity_binding"],
        "peer_identity_binding": ["peer_node_id"]
      },
      "properties": {
        "warm_state": {"enum": ["cold", "warm", "not_applicable"]},
        "notes": {"type": "string", "maxLength": 4096},
        "local_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "peer_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "peer_identity_binding": {
          "enum": [
            "unauthenticated_server_report_v1",
            "caller_asserted_v1",
            "computemesh_ed25519_session_v1"
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}
    },
    "raw_samples": {
      "type": "array",
      "items": {"type": ["number", "integer", "string", "boolean", "null", "object"]}
    }
  }
}

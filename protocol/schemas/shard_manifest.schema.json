{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/shard_manifest.schema.json",
  "title": "ComputeMesh Shard Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shard_id", "model_version", "content_digest", "size_bytes", "range", "quantization", "runtime_compatibility", "memory_estimate_bytes"],
  "properties": {
    "schema_version": {"const": 1},
    "shard_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
          "minItems": 2,
          "maxItems": 2
        },
        "experts": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
      },
      "anyOf": [{"required": ["layers"]}, {"required": ["experts"]}]
    },
    "quantization": {"type": "string", "minLength": 1},
    "runtime_compatibility": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "memory_estimate_bytes": {"type": "integer", "minimum": 1},
    "signature": {"type": ["object", "null"], "additionalProperties": true}
  }
}

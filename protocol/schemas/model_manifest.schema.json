{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/model_manifest.schema.json",
  "title": "ComputeMesh Model Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "model_version", "architecture", "license", "runtime_compatibility", "quantizations", "partitioning", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 256},
    "architecture": {"type": "string", "minLength": 1},
    "layer_count": {"type": "integer", "minimum": 2, "maximum": 100000},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "redistribution_allowed": {"type": "boolean"}
      }
    },
    "runtime_compatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime"],
        "properties": {
          "runtime": {"type": "string", "minLength": 1},
          "min_version": {"type": "string"},
          "max_version": {"type": "string"}
        }
      }
    },
    "quantizations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "partitioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": {"type": "array", "items": {"enum": ["contiguous_layers", "experts", "replica"]}, "uniqueItems": true}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "size_bytes"],
        "properties": {
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "media_type": {"type": "string"}
        }
      }
    }
  }
}

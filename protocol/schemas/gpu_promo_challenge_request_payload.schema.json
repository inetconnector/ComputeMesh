{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/gpu_promo_challenge_request_payload.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "session_revision", "challenge"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "session_revision": {"type": "integer", "minimum": 0},
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "challenge_id", "claim_class", "owner_id", "node_id",
        "key_id", "hardware_claim_id", "evidence_digest", "nonce", "prompt",
        "seed", "n_predict", "model_sha256", "expected_llama_build_number",
        "expected_llama_build_commit", "timeout_ms"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "challenge_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "claim_class": {"const": "gpu_onboarding"},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "hardware_claim_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 4096},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "n_predict": {"type": "integer", "minimum": 8, "maximum": 128},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_llama_build_number": {"type": "integer", "minimum": 1},
        "expected_llama_build_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
        "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 300000}
      }
    }
  }
}

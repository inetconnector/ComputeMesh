{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "lease_id", "memory_mb", "ttl_seconds", "device_id"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "lease_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "memory_mb": {"type": "integer", "minimum": 0, "maximum": 104857600},
    "ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}

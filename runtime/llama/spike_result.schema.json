{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/llama_rpc_spike_result.schema.json",
  "title": "ComputeMesh llama.cpp RPC Spike Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "captured_at", "runtime", "model", "topology", "placement", "timings", "correctness"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^llama-rpc-[0-9a-f]{16}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["name", "version"],
      "properties": {"name": {"const": "llama.cpp"}, "version": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["basename", "size_bytes", "sha256"],
      "properties": {
        "basename": {"type": "string", "minLength": 1, "maxLength": 512},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "topology": {
      "type": "object", "additionalProperties": false, "required": ["rpc_endpoints", "coordinator_http"],
      "properties": {
        "rpc_endpoints": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 64}},
        "coordinator_http": {"type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]{1,5}$"}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "split_mode", "devices", "tensor_split", "fit"],
      "properties": {
        "mode": {"enum": ["local_baseline", "shared_rpc"]},
        "split_mode": {"enum": ["none", "layer"]},
        "devices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "tensor_split": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "fit": {"const": false}
      }
    },
    "timings": {
      "type": "object", "additionalProperties": true,
      "required": ["model_ready_ms", "request_ms", "prompt_n", "prompt_ms", "prompt_per_second", "predicted_n", "predicted_ms", "predicted_per_second"],
      "properties": {
        "model_ready_ms": {"type": "number", "minimum": 0},
        "request_ms": {"type": "number", "minimum": 0},
        "prompt_n": {"type": "integer", "minimum": 0},
        "prompt_ms": {"type": "number", "minimum": 0},
        "prompt_per_second": {"type": "number", "minimum": 0},
        "predicted_n": {"type": "integer", "minimum": 0},
        "predicted_ms": {"type": "number", "minimum": 0},
        "predicted_per_second": {"type": "number", "minimum": 0}
      }
    },
    "correctness": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_sha256", "output_sha256", "token_ids_sha256"],
      "properties": {
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "token_ids_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

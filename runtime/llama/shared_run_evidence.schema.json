{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/m1_shared_run_evidence.schema.json",
  "title": "ComputeMesh M1 Two-Node Shared Runtime Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "captured_at",
    "scope",
    "experiment_bundle_id",
    "placement_decision_id",
    "model",
    "runtime",
    "planner_split",
    "sources",
    "correctness",
    "performance",
    "production_scheduling"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^shared-run-evidence-[0-9a-f]{16}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "m1_two_node_shared_runtime_proof"},
    "experiment_bundle_id": {"type": "string", "pattern": "^experiment-bundle-[0-9a-f]{16}$"},
    "placement_decision_id": {"type": "string", "pattern": "^placement-[0-9a-f]{16}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "size_bytes", "sha256"],
      "properties": {
        "basename": {"type": "string", "minLength": 1, "maxLength": 512},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "llama.cpp"},
        "version": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "planner_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensor_split", "layer_ranges"],
      "properties": {
        "tensor_split": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "layer_ranges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "start_layer", "end_layer_exclusive"],
            "properties": {
              "node_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "start_layer": {"type": "integer", "minimum": 0},
              "end_layer_exclusive": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_bundle", "baseline", "shared", "relay"],
      "properties": {
        "experiment_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_name", "document_sha256", "bundle_id"],
          "properties": {
            "file_name": {"$ref": "#/$defs/file_name"},
            "document_sha256": {"$ref": "#/$defs/document_sha256"},
            "bundle_id": {"type": "string", "pattern": "^experiment-bundle-[0-9a-f]{16}$"}
          }
        },
        "baseline": {"$ref": "#/$defs/spike_source"},
        "shared": {"$ref": "#/$defs/spike_source"},
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_name", "document_sha256", "listen", "target"],
          "properties": {
            "file_name": {"$ref": "#/$defs/file_name"},
            "document_sha256": {"$ref": "#/$defs/document_sha256"},
            "listen": {"type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]{1,5}$"},
            "target": {"type": "string", "minLength": 3, "maxLength": 64}
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_sha256",
        "exact_output_match",
        "match_basis",
        "baseline_output_sha256",
        "shared_output_sha256",
        "baseline_token_ids_sha256",
        "shared_token_ids_sha256"
      ],
      "properties": {
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "exact_output_match": {"const": true},
        "match_basis": {"enum": ["token_ids_sha256", "output_sha256"]},
        "baseline_output_sha256": {"$ref": "#/$defs/sha256"},
        "shared_output_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_token_ids_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "shared_token_ids_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_request_ms",
        "shared_request_ms",
        "baseline_prompt_tokens_per_second",
        "shared_prompt_tokens_per_second",
        "baseline_predicted_tokens_per_second",
        "shared_predicted_tokens_per_second",
        "shared_over_baseline",
        "relay_setup_elapsed_ms",
        "relay_active_elapsed_ms",
        "relay_total_elapsed_ms",
        "coordinator_to_worker_bytes",
        "worker_to_coordinator_bytes",
        "total_forwarded_bytes"
      ],
      "properties": {
        "baseline_request_ms": {"type": "number", "minimum": 0},
        "shared_request_ms": {"type": "number", "minimum": 0},
        "baseline_prompt_tokens_per_second": {"type": "number", "minimum": 0},
        "shared_prompt_tokens_per_second": {"type": "number", "minimum": 0},
        "baseline_predicted_tokens_per_second": {"type": "number", "minimum": 0},
        "shared_predicted_tokens_per_second": {"type": "number", "minimum": 0},
        "shared_over_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_tokens_per_second", "predicted_tokens_per_second", "request_ms"],
          "properties": {
            "prompt_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
            "predicted_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
            "request_ms": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "relay_setup_elapsed_ms": {"type": "number", "minimum": 0},
        "relay_active_elapsed_ms": {"type": "number", "minimum": 0},
        "relay_total_elapsed_ms": {"type": "number", "minimum": 0},
        "coordinator_to_worker_bytes": {"type": "integer", "minimum": 1},
        "worker_to_coordinator_bytes": {"type": "integer", "minimum": 1},
        "total_forwarded_bytes": {"type": "integer", "minimum": 2}
      }
    },
    "production_scheduling": {"const": false}
  },
  "$defs": {
    "file_name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
    "document_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spike_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "document_sha256", "run_id"],
      "properties": {
        "file_name": {"$ref": "#/$defs/file_name"},
        "document_sha256": {"$ref": "#/$defs/document_sha256"},
        "run_id": {"type": "string", "pattern": "^llama-rpc-[0-9a-f]{16}$"}
      }
    }
  }
}

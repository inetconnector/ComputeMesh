{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/tcp_measurement_relay.schema.json",
  "title": "ComputeMesh TCP Measurement Relay Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "started_at", "ended_at", "listen", "target", "elapsed_ms", "configured", "traffic", "termination"],
  "properties": {
    "schema_version": {"const": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "listen": {"type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]{1,5}$"},
    "target": {"type": "string", "minLength": 3, "maxLength": 64},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "configured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_way_delay_ms", "jitter_ms", "seed", "chunk_bytes", "max_buffer_bytes", "disconnect_after_bytes", "disconnect_after_seconds"],
      "properties": {
        "one_way_delay_ms": {"type": "number", "minimum": 0, "maximum": 60000},
        "jitter_ms": {"type": "number", "minimum": 0, "maximum": 60000},
        "seed": {"type": "integer"},
        "chunk_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "max_buffer_bytes": {"type": "integer", "minimum": 1024, "maximum": 268435456},
        "disconnect_after_bytes": {"type": ["integer", "null"], "minimum": 1},
        "disconnect_after_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinator_to_worker_bytes", "worker_to_coordinator_bytes", "total_forwarded_bytes"],
      "properties": {
        "coordinator_to_worker_bytes": {"type": "integer", "minimum": 0},
        "worker_to_coordinator_bytes": {"type": "integer", "minimum": 0},
        "total_forwarded_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "error_type", "message"],
      "properties": {
        "reason": {"enum": ["eof", "disconnect_after_bytes", "disconnect_after_seconds", "error"]},
        "error_type": {"type": ["string", "null"], "maxLength": 128},
        "message": {"type": ["string", "null"], "maxLength": 1024}
      }
    }
  }
}

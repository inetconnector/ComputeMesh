[Unit]
Description=ComputeMesh Concert Research MCP server
After=network-online.target computemesh-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ComputeMesh
EnvironmentFile=-/etc/computemesh/concert-research.env
ExecStart=/usr/bin/python3 -m services.concert_research.mcp_server --transport http --host 127.0.0.1 --port 8098 --bootstrap-seeds
Restart=on-failure
RestartSec=5
User=computemesh
Group=computemesh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/computemesh

[Install]
WantedBy=multi-user.target

# Copy to /etc/computemesh/provider.env and restrict it to root (0640).
# This file contains paths and identifiers only. Store private key material in
# the protected path referenced below; never put key contents in this file.

COMPUTEMESH_CONTROL_HOST=control.example.invalid
COMPUTEMESH_CONTROL_PORT=7443
COMPUTEMESH_CONTROL_CA_FILE=/etc/computemesh/control-ca.pem
COMPUTEMESH_NODE_ID=node_replace_me
COMPUTEMESH_NODE_PRIVATE_KEY=/var/lib/computemesh/node-ed25519.pem
COMPUTEMESH_NODE_PROFILE=/var/lib/computemesh/evidence/node_profile.json
COMPUTEMESH_NODE_PREFILL=/var/lib/computemesh/evidence/prefill.json
COMPUTEMESH_NODE_DECODE=/var/lib/computemesh/evidence/decode.json
COMPUTEMESH_NODE_RPC_HOST=127.0.0.1
COMPUTEMESH_NODE_RPC_PORT=50052
COMPUTEMESH_LLAMA_BUILD_NUMBER=replace_me
COMPUTEMESH_LLAMA_BUILD_COMMIT=replace_me

# Optional provider features consumed by apps/node/provider_agent.py:
# COMPUTEMESH_MODEL_CATALOGUE=/var/lib/computemesh/evidence/model-catalogue.json
# COMPUTEMESH_NODEOS_INFERENCE_ENDPOINT=http://127.0.0.1:8081/v1/chat/completions
# COMPUTEMESH_NODEOS_INFERENCE_AUTH_TOKEN=use-a-local-secret-file-or-manager
# COMPUTEMESH_MODEL_PREPARATION_MANIFEST=/var/lib/computemesh/evidence/model-preparation.json
# COMPUTEMESH_NODEOS_ENVIRONMENT_ROOT=/var/lib/computemesh/agent-environments
# COMPUTEMESH_NODEOS_STOP_MANAGED_MODEL_ON_CANCEL=1

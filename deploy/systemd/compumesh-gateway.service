[Unit]
Description=ComputeMesh High-Performance Inferenz Gateway Service
Documentation=https://mesh.inetconnector.com/docs
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mesh.inetconnector.com
Environment=PYTHONPATH=/var/www/mesh.inetconnector.com:/var/www/mesh.inetconnector.com/ControlPlane
Environment=COMPUTEMESH_GATEWAY_PORT=8080
Environment=COMPUTEMESH_ENV=production
ExecStart=/usr/bin/python3 -m services.gateway.server --port 8080 --host 127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

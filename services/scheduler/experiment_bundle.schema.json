{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computemesh.dev/schema/experiment_bundle.schema.json",
  "title": "ComputeMesh M1 Two-Node Experiment Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "captured_at",
    "scope",
    "benchmark_model_name",
    "sources",
    "placement_decision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {
      "type": "string",
      "pattern": "^experiment-bundle-[a-f0-9]{16}$"
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "scope": {"const": "m1_two_node_placement_evidence"},
    "benchmark_model_name": {"type": "string", "minLength": 1, "maxLength": 512},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_manifest", "coordinator", "worker", "network"],
      "properties": {
        "model_manifest": {
          "allOf": [
            {"$ref": "#/$defs/document"},
            {
              "type": "object",
              "required": ["model_id", "model_version", "artifact_digest", "artifact_size_bytes", "layer_count"],
              "properties": {
                "model_id": {"type": "string", "minLength": 1},
                "model_version": {"type": "string", "minLength": 1},
                "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                "artifact_size_bytes": {"type": "integer", "minimum": 1},
                "layer_count": {"type": "integer", "minimum": 2, "maximum": 100000}
              }
            }
          ]
        },
        "coordinator": {"$ref": "#/$defs/node_evidence"},
        "worker": {"$ref": "#/$defs/node_evidence"},
        "network": {
          "allOf": [
            {"$ref": "#/$defs/document"},
            {
              "type": "object",
              "required": ["run_id", "local_node_id", "peer_node_id", "peer_identity_binding"],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "local_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "peer_node_id": {"type": "string", "minLength": 1, "maxLength": 128},
                "peer_identity_binding": {"type": "string", "minLength": 1, "maxLength": 128}
              }
            }
          ]
        }
      }
    },
    "placement_decision": {
      "type": "object",
      "required": ["schema_version", "decision_id", "scope", "model", "nodes", "network_evidence", "hard_constraints", "candidates", "performance_evidence", "recommendation"]
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": ["file_name", "document_sha256"],
      "properties": {
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "benchmark_source": {
      "allOf": [
        {"$ref": "#/$defs/document"},
        {
          "type": "object",
          "required": ["run_id"],
          "properties": {
            "run_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "profile_source": {
      "allOf": [
        {"$ref": "#/$defs/document"},
        {
          "type": "object",
          "required": ["node_id", "profile_revision"],
          "properties": {
            "node_id": {"type": "string", "minLength": 1},
            "profile_revision": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "node_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "prefill", "decode"],
      "properties": {
        "profile": {"$ref": "#/$defs/profile_source"},
        "prefill": {"$ref": "#/$defs/benchmark_source"},
        "decode": {"$ref": "#/$defs/benchmark_source"}
      }
    }
  }
}

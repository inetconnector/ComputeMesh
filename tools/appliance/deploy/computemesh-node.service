[Unit]
Description=ComputeMesh AI Provider Node Daemon (Debian/Ubuntu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/computemesh/tools/appliance/linux_tray_app.py --service
WorkingDirectory=/opt/computemesh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=process
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
